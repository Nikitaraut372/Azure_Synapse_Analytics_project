		{
			"name": "[concat(parameters('workspaceName'), '/DataTransformation')]",
			"type": "Microsoft.Synapse/workspaces/dataflows",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_parquetBronze",
								"type": "DatasetReference"
							},
							"name": "sourceBronze"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver",
								"type": "DatasetReference"
							},
							"name": "silverDestination"
						}
					],
					"transformations": [
						{
							"name": "filterlessthan100"
						},
						{
							"name": "addDomain"
						},
						{
							"name": "fetchonlyDomain"
						}
					],
					"scriptLines": [
						"source(output(",
						"          OrderID as string,",
						"          OrderDate as string,",
						"          CustomerID as string,",
						"          CustomerName as string,",
						"          CustomerEmail as string,",
						"          ProductID as string,",
						"          ProductName as string,",
						"          ProductCategory as string,",
						"          RegionID as string,",
						"          RegionName as string,",
						"          Country as string,",
						"          Quantity as string,",
						"          UnitPrice as string,",
						"          TotalAmount as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet') ~> sourceBronze",
						"sourceBronze filter(UnitPrice>='100') ~> filterlessthan100",
						"filterlessthan100 derive(Domain = split(CustomerEmail,'@')) ~> addDomain",
						"addDomain derive(Domain = slice(Domain, 2)[1]) ~> fetchonlyDomain",
						"fetchonlyDomain sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> silverDestination"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('workspaceId'), '/datasets/ds_parquetBronze')]",
				"[concat(variables('workspaceId'), '/datasets/ds_silver')]"
			]
		},
